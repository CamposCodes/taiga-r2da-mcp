# Variables read by taiga-mcp. The server reads them from its environment: it does not load this file by itself.
# MCP clients set them in their own configuration (see docs/clients/). To start the server by hand: copy this
# file to .env, fill it in and run "node --env-file=.env dist/index.js".
# "npm run test:live" reads the same .env (see docs/TESTING.md).
# Never commit the copy: .env is in .gitignore.

# Address of the Taiga site, with or without /api/v1 at the end. It must start with https://.
TAIGA_URL=https://taiga.example.com

# Session token of Taiga 6: the value of "token" in the Local Storage of the browser, after login.
TAIGA_TOKEN=<YOUR_TOKEN>

# Optional. 1 or true registers the seven tools that create and edit user stories, tasks and issues and attach
# files. Any other value (yes, on, TRUE, 0), or no value, keeps the server read-only.
# TAIGA_WRITE=1

# Optional, and only with TAIGA_WRITE on. 1 or true registers the tool that deletes user stories, tasks and
# issues. Any other value, or no value, keeps it off.
# TAIGA_DELETE=1

# Only for "npm run test:live": slug of the one project the test may write to.
# TAIGA_TEST_PROJECT=my-project
