{
  "name": "@campos-codes/taiga-r2da-mcp",
  "version": "0.3.0",
  "mcpName": "io.github.CamposCodes/taiga-r2da-mcp",
  "description": "MCP server for a Taiga 6 installation: lets AI models read projects, user stories, tasks, issues, sprints and attachments, and optionally create, edit, move and delete user stories, tasks and issues and attach files to them",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "taiga",
    "project-management",
    "kanban",
    "scrum",
    "claude",
    "codex",
    "ai-agents"
  ],
  "homepage": "https://github.com/CamposCodes/taiga-r2da-mcp#readme",
  "bugs": {
    "url": "https://github.com/CamposCodes/taiga-r2da-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CamposCodes/taiga-r2da-mcp.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "taiga-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "node test/smoke.mjs dist/index.js",
    "coverage": "node test/coverage.mjs dist/index.js",
    "test:live": "node test/live.mjs dist/index.js",
    "pack:mcpb": "node scripts/pack-mcpb.mjs",
    "docs:tools": "node scripts/readme-tools.mjs",
    "prepublishOnly": "npm run build && npm test",
    "prepack": "node scripts/npm-readme.mjs",
    "postpack": "node scripts/npm-readme.mjs --clean"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
